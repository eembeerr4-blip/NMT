# env files (can opt-in for committing if needed)
.env*
!.env.example
/data/secrets.json
/prisma/*.db
/prisma/*.db-journal
/test-results/
/playwright-report/
/blob-report/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite data, journal sidecars and local hardening artifacts
*.db
*.db-*
*.db.backup-*
/prisma/dev.db.pre-*
/prisma/hardening-checkpoint.prisma

