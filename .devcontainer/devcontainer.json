{
  "name": "NMT Academy",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "remoteUser": "node",
  "postCreateCommand": "npm ci && npm run prisma:generate",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "NMT Academy", "onAutoForward": "notify", "visibility": "private" }
  },
  "containerEnv": {
    "DATABASE_URL": "file:./codespaces.db",
    "NEXT_TELEMETRY_DISABLED": "1",
    "CHECKPOINT_DISABLE": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": ["GitHub.copilot-chat", "GitHub.vscode-pull-request-github", "dbaeumer.vscode-eslint", "Prisma.prisma", "vitest.explorer", "ms-playwright.playwright"]
    }
  }
}
