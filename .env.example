DATABASE_URL="file:./dev.db"

# Closed registration and password recovery (keep credentials only in local env or secret manager).
# For a local QA server use http://localhost:<port>; public beta requires HTTPS.
AUTH_BASE_URL="http://localhost:3000"
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Optional local-only mail sink for isolated browser QA; never use with a public app URL.
# AUTH_MAIL_QA_ENDPOINT="http://127.0.0.1:3102/emails"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only enable behind a reverse proxy that strips client x-nmt-client-ip and sets one verified IP.
# Public multi-instance deployments also need a shared login rate limiter at the proxy.
# AUTH_TRUSTED_PROXY=1

# Ключі можна задати тут або на сторінці налаштувань.
# Вони не потрібні для навчання, тестів і аналітики.
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL="http://127.0.0.1:11434"
YOUTUBE_API_KEY=

# Set false only for a local HTTP site running via next start. HTTPS production defaults to true.
# SESSION_COOKIE_SECURE=false
