generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(cuid())
  email        String?             @unique
  emailVerifiedAt DateTime?
  oauthAccounts OAuthAccount[]
  authTokens AuthToken[]
  role         String              @default("STUDENT")
  diagnosticSkipped Boolean        @default(false)
  videoProgress UserVideoProgress[]
  firstName    String
  lastName     String              @default("")
  nickname     String              @unique
  passwordHash String              @default("")
  examYear     Int                 @default(2027)
  onboarded    Boolean             @default(false)
  accountStatus String             @default("PENDING")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  settings     UserSettings?
  subjects     UserSubject[]
  sessions     Session[]
  progress     UserTopicProgress[]
  externalPractice ExternalPractice[]
}

model OAuthAccount {
  id String @id @default(cuid())
  userId String
  provider String
  providerSubject String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
}

model AuthToken {
  id String @id @default(cuid())
  userId String
  purpose String
  targetEmail String?
  tokenHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model Invitation {
  id String @id @default(cuid())
  codeHash String @unique
  email String
  expiresAt DateTime
  consumedAt DateTime?
  consumedById String?
  createdAt DateTime @default(now())
  createdById String

  @@index([email])
  @@index([expiresAt])
}

model OAuthFlow {
  id String @id @default(cuid())
  stateHash String @unique
  codeVerifier String
  nonce String
  invitationId String?
  linkUserId String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSubject {
  id        String  @id @default(cuid())
  userId    String
  subjectId String
  role      String
  active    Boolean @default(true)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
}

model UserTopicProgress {
  id          String  @id @default(cuid())
  userId      String
  topicId     String
  status      String  @default("NOT_STARTED")
  lastCorrect Int?
  lastTotal   Int?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

model UserSettings {
  id                  String    @id @default("default")
  userId              String?   @unique
  user                User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme               String    @default("system")
  examDate            DateTime?
  targetScore         Int       @default(150)
  masteryHighMin      Int       @default(10)
  masteryMidMin       Int       @default(7)
  mathPriority        Int       @default(35)
  ukrainianPriority   Int       @default(25)
  historyPriority     Int       @default(20)
  biologyPriority     Int       @default(20)
  timerEnabled        Boolean   @default(true)
  scheduleJson        String
  formatJson          String
  planStart           String    @default("2026-10-19")
  dailyMinutes        Int       @default(150)
  intensity           String    @default("standard")
  preferredTime       String    @default("18:00")
  studyDaysJson       String    @default("[0,1,2,3,4,5,6]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Subject {
  id          String       @id
  name        String
  shortName   String
  description String
  color       String
  sortOrder   Int
  topics      Topic[]
  selections  UserSubject[]
  questions   Question[]
  examResults ExamResult[]
  tests       Test[]
  mistakes    Mistake[]
  flashcards  Flashcard[]
  sessions    StudySession[]
  tasks       StudyTask[]
}

model Topic {
  id            String            @id
  subjectId     String
  parentId      String?
  title         String
  summary       String            @default("")
  formulas      String            @default("")
  sortOrder     Int
  status        String            @default("NOT_STARTED")
  coverage      String            @default("NEEDS_CONTENT")
  lessonJson    String            @default("")
  estimatedMin  Int               @default(25)
  lastCorrect   Int?
  progress      UserTopicProgress[]
  lastTotal     Int?
  subject       Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent        Topic?            @relation("TopicTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Topic[]           @relation("TopicTree")
  videos        VideoLesson[]
  questions     Question[]
  tests         Test[]
  reviews       ReviewSchedule[]
  flashcards    Flashcard[]
  mistakes      Mistake[]
  tasks         StudyTask[]
  sessions      StudySession[]
  dependsOn     TopicDependency[] @relation("Dependent")
  requiredBy    TopicDependency[] @relation("Prerequisite")

  @@index([subjectId, sortOrder])
}

model TopicDependency {
  id             String @id @default(cuid())
  topicId        String
  prerequisiteId String
  topic          Topic  @relation("Dependent", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite   Topic  @relation("Prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([topicId, prerequisiteId])
  @@index([prerequisiteId])
}

model VideoLesson {
  id              String   @id @default(cuid())
  topicId         String
  youtubeId       String
  url             String
  title           String   @default("")
  isPrimary       Boolean  @default(false)
  role            String   @default("primary")
  channel         String   @default("")
  reviewStatus    String   @default("CONFIRMED")
  language        String   @default("uk")
  durationSec     Int?
  lastPositionSec Int      @default(0)
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  topic           Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress        UserVideoProgress[]

  @@index([topicId])
}

model Question {
  id                 String           @id @default(cuid())
  subjectId          String
  topicId            String?
  subtopic           String           @default("")
  type               String
  difficulty         String
  prompt             String
  explanation        String
  correctAnswer      String
  source             String           @default("")
  verificationStatus String           @default("DRAFT")
  generatedByAi      Boolean          @default(false)
  issueReport        String           @default("")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  subject            Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic              Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  options            QuestionOption[]
  testQuestions      TestQuestion[]
  answers            Answer[]
  mistakes           Mistake[]

  @@index([subjectId, topicId, verificationStatus])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  label      String
  text       String
  sortOrder  Int      @default(0)
  matchKey   String?
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Test {
  id           String         @id @default(cuid())
  subjectId    String?
  topicId      String?
  title        String
  kind         String
  timeLimitSec Int?
  configJson   String         @default("{}")
  createdAt    DateTime       @default(now())
  subject      Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic        Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  questions    TestQuestion[]
  attempts     TestAttempt[]

  @@index([topicId])
  @@index([subjectId])
}

model TestQuestion {
  id         String   @id @default(cuid())
  testId     String
  questionId String
  sortOrder  Int
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])
}

model TestAttempt {
  id           String    @id @default(cuid())
  testId       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  durationSec  Int?
  status       String    @default("IN_PROGRESS")
  draftJson    String    @default("{}")
  currentIndex Int       @default(0)
  userId       String?
  correctCount Int?
  totalCount   Int?
  pendingCount Int?
  percent      Float?
  test         Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers      Answer[]

  @@index([status])
  @@index([userId])
  @@index([userId, status])
}

model Answer {
  id                 String      @id @default(cuid())
  attemptId          String
  questionId         String
  userAnswer         String
  isCorrect          Boolean?
  needsManualReview  Boolean     @default(false)
  createdAt          DateTime    @default(now())
  attempt            TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question           Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model ExamResult {
  externalPractice ExternalPractice?
  id                  String   @id @default(cuid())
  subjectId           String
  date                DateTime
  testType            String
  title               String
  source              String   @default("")
  rawScore            Int?
  maxRawScore         Int?
  ratingScore         Int?
  belowThreshold      Boolean  @default(false)
  partial             Boolean  @default(false)
  countsTowardAverage Boolean  @default(false)
  durationSec         Int?
  errorCount          Int?
  comment             String   @default("")
  userId              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  subject             Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, date])
  @@index([userId, date])
}

model StudySession {
  id          String    @id @default(cuid())
  subjectId   String?
  topicId     String?
  startedAt   DateTime
  endedAt     DateTime?
  durationMin Int       @default(0)
  kind        String    @default("study")
  note        String    @default("")
  userId      String?
  subject     Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic       Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@index([userId])
}

model StudyTask {
  externalPractice ExternalPractice?
  id           String    @id @default(cuid())
  dateKey      String
  subjectId    String?
  topicId      String?
  title        String
  detail       String    @default("")
  kind         String
  durationMin  Int       @default(0)
  status       String    @default("PLANNED")
  templateKey  String?
  optional     Boolean   @default(false)
  sortOrder    Int       @default(0)
  notes        String    @default("")
  completedAt  DateTime?
  userId       String?
  movedFromId  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  subject      Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic        Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([userId, dateKey, templateKey])
  @@index([dateKey, status])
  @@index([userId, dateKey])
}

model ReviewSchedule {
  id           String    @id @default(cuid())
  topicId      String
  dueKey       String
  intervalDays Int
  status       String    @default("PENDING")
  priority     Int       @default(0)
  completedAt  DateTime?
  userId       String?
  createdAt    DateTime  @default(now())
  topic        Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([dueKey, status])
  @@index([userId, dueKey, status])
}

model Mistake {
  retries MistakeRetry[]
  id            String    @id @default(cuid())
  subjectId     String
  topicId       String?
  questionId    String?
  prompt        String
  userAnswer    String
  correctAnswer String
  explanation   String
  category      String    @default("UNKNOWN_TOPIC")
  repeatCount   Int       @default(1)
  status        String    @default("OPEN")
  userId        String?
  date          DateTime  @default(now())
  subject       Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic         Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  question      Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([subjectId, status])
  @@index([topicId])
  @@index([userId, status])
}

model Flashcard {
  id           String   @id @default(cuid())
  subjectId    String?
  topicId      String?
  kind         String
  front        String
  back         String
  ease         Float    @default(2.5)
  intervalDays Int      @default(0)
  dueKey       String
  reps         Int      @default(0)
  lapses       Int      @default(0)
  userId       String?
  subject      Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic        Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([dueKey])
  @@index([userId, dueKey])
}

model UserVideoProgress {
  id String @id @default(cuid())
  userId String
  videoId String
  lastPositionSec Int @default(0)
  notes String @default("")
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  video VideoLesson @relation(fields: [videoId], references: [id], onDelete: Cascade)
  @@unique([userId, videoId])
}

// Actor snapshots deliberately survive profile deletion and backup restore.
model AuditLog {
 id String @id @default(cuid())
 actorId String?
 actorName String
 actorRole String
 action String
 entityType String
 entityId String?
 summary String
 metadataJson String @default("{}")
 createdAt DateTime @default(now())
 @@index([createdAt, id])
 @@index([action, createdAt])
 @@index([actorId, createdAt])
}


// External assignments are reservations, not TestAttempt/Answer records.
model ExternalPractice {
  id String @id @default(cuid())
  userId String
  subjectId String
  provider String @default("ZNO_ONLINE")
  variantNumber Int
  title String
  url String
  questionCount Int
  initialDate String
  taskId String @unique
  status String @default("PLANNED")
  resultId String? @unique
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  task StudyTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  result ExamResult? @relation(fields: [resultId], references: [id], onDelete: Restrict)
  revisions ExternalResultRevision[]
  @@unique([userId, subjectId, variantNumber])
  @@index([userId, status])
}

model ExternalResultRevision {
  id String @id @default(cuid())
  assignmentId String
  version Int
  snapshotJson String
  createdAt DateTime @default(now())
  assignment ExternalPractice @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  @@unique([assignmentId, version])
}

model MistakeRetry {
  id String @id
  mistakeId String
  answerJson String
  isCorrect Boolean?
  createdAt DateTime @default(now())
  mistake Mistake @relation(fields:[mistakeId],references:[id],onDelete:Cascade)
  @@index([mistakeId,createdAt])
}
